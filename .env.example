# ---- 公開ポート ----
PROXY_PORT=8080

# ---- データベース ----
POSTGRES_USER=llmconsole
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=llmconsole

# ---- gateway ----
# openssl rand -hex 32 で生成すること
SECRET_KEY=change-me-openssl-rand-hex-32
SESSION_TTL_HOURS=12
COOKIE_SECURE=false          # HTTPS 化したら true
LOG_LEVEL=INFO
ENABLE_PROMPT_LOGGING=false  # true にすると usage_logs に本文が残る。既定 false

# ---- 制限（既定値。ユーザーごとに quotas テーブルで上書き可） ----
DEFAULT_RPM_LIMIT=60
DEFAULT_MAX_CONCURRENT=2

# ---- 初期管理者（seed.py が使用） ----
ADMIN_EMAIL=admin@example.local
ADMIN_INITIAL_PASSWORD=change-me-on-first-login

# ---- 既定モデル ----
DEFAULT_CHAT_MODEL=qwen3:4b
DEFAULT_EMBED_MODEL=bge-m3
DEFAULT_NUM_CTX=4096

# ---- RAG（Phase 2） ----
UPLOADS_DIR=/app/uploads
MAX_UPLOAD_SIZE_BYTES=20971520
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=200
RAG_TOP_K=4
RAG_DISTANCE_THRESHOLD=0.6
